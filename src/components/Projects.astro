---
import { getCollection } from "astro:content";
import { IconArrowRight, IconChevronRight } from "@tabler/icons-react";
import { getImage } from "astro:assets";

const projectsEntries = await getCollection("projects");

const projects = await Promise.all(
    projectsEntries.map(async (p: any, idx: number) => {
        const data = p.data;
        const optimizedGalleries = await Promise.all(
            data.images.map(async (img: any) => {
                const optimized = await getImage({
                    src: img,
                    width: 1200,
                    format: "webp",
                    quality: 85,
                });
                return optimized.src;
            })
        );
        return { 
            ...data, 
            gallery: optimizedGalleries,
            displayId: (projectsEntries.length - idx).toString().padStart(2, "0")
        };
    })
);
---

<section
    id="projects"
    class="relative bg-brand-bg py-24 md:py-36 px-6 md:px-12 overflow-hidden border-t border-brand-text/5"
>
    <div class="absolute inset-0 w-full flex justify-center pointer-events-none select-none z-0">
        <div class="h-screen flex items-center justify-center sticky top-0">
            <span class="text-[17vw] font-bold text-brand-text/5 leading-none uppercase" id="projects-bg-text">
                PROJECTS
            </span>
        </div>
    </div>

    <div class="max-w-7xl mx-auto relative z-10">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 md:mb-28 gap-8">
            <div class="overflow-hidden">
                <h2 class="text-brand-accent mb-4 tracking-[0.5em] uppercase text-xs" id="projects-tag">
                    02 / SELECTED WORKS
                </h2>
                <h3 class="text-4xl md:text-8xl font-bold leading-none tracking-widest" id="projects-title">
                    PORTFOLIO <br /> ARCHIVE
                </h3>
            </div>
            <div class="md:text-right max-w-xs overflow-hidden">
                <p class="text-[11px] leading-relaxed text-brand-text/50 uppercase tracking-widest" id="projects-info">
                    A Curated Selection of High-End Digital Solutions &amp; Technical Architecture.
                </p>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
            
            <div class="hidden lg:block lg:col-span-5 lg:sticky lg:top-32 z-20">
                <div class="p-2 bg-brand-text/5 border border-brand-text/10 rounded-[2rem] shadow-2xl">
                    <div class="relative aspect-[4/3] rounded-[calc(2rem-0.5rem)] overflow-hidden bg-brand-bg border border-brand-text/5">
                        {projects.map((project: any, pIdx: number) => (
                            <div 
                                class={`project-showcase absolute inset-0 w-full h-full transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] ${pIdx === 0 ? "opacity-100 scale-100 z-10" : "opacity-0 scale-95 z-0 pointer-events-none"}`}
                                data-showcase-index={pIdx}
                            >
                                {project.gallery.map((img: string, imgIdx: number) => (
                                    <img
                                        src={img}
                                        alt={`${project.title} preview ${imgIdx + 1}`}
                                        loading={imgIdx === 0 ? "eager" : "lazy"}
                                        decoding="async"
                                        class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-400 ease-in-out ${imgIdx === 0 ? "opacity-100 z-10" : "opacity-0 z-0"}`}
                                    />
                                ))}
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            <div class="lg:col-span-7 border-t border-brand-text/10" id="projects-list-container">
                {projects.map((project: any, pIdx: number) => (
                    <div 
                        class={`project-row group/row border-b border-brand-text/10 transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-brand-text/[0.02] ${pIdx === 0 ? "is-active lg:bg-brand-text/[0.02]" : ""}`}
                        data-project-index={pIdx}
                    >
                        <div class="flex items-center justify-between py-8 lg:py-10 cursor-pointer px-2 lg:px-4 select-none row-trigger">
                            <div class="flex items-baseline gap-4 md:gap-8">
                                <span class="text-[10px] md:text-xs font-mono font-bold tracking-widest text-brand-text/30 group-hover/row:text-brand-accent transition-colors duration-200">
                                    [{project.displayId}]
                                </span>
                                <h4 class="text-xl md:text-4xl font-bold tracking-wider text-brand-text group-hover/row:text-brand-accent transition-colors duration-200">
                                    {project.title}
                                </h4>
                            </div>
                            
                            <div class="flex items-center gap-6 shrink-0">
                                <span class="hidden md:block text-[9px] font-bold tracking-[0.25em] text-brand-text/40 uppercase group-hover/row:text-brand-text/70 transition-colors duration-200">
                                    {project.category}
                                </span>
                                <span class="text-xs md:text-sm font-mono font-bold text-brand-text/20 group-hover/row:text-brand-text transition-colors duration-200">
                                    {project.year}
                                </span>
                                <div class="w-8 h-8 rounded-full border border-brand-text/10 flex items-center justify-center group-hover/row:border-brand-accent group-hover/row:bg-brand-accent/10 transition-all duration-200 row-chevron-box">
                                    <span class="text-brand-text/50 group-hover/row:text-brand-accent transition-colors duration-200 transform group-hover/row:rotate-45">
                                        <IconArrowRight size={16} stroke={2} />
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="project-row-panel grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] px-2 lg:px-4">
                            <div class="overflow-hidden">
                                <div class="pb-8 pt-2 space-y-6">
                                    <div class="lg:hidden w-full p-1 bg-brand-text/5 border border-brand-text/10 rounded-[1.5rem] mb-6">
                                        <div class="relative aspect-[16/10] rounded-[calc(1.5rem-0.25rem)] overflow-hidden bg-brand-bg project-mobile-gallery">
                                            {project.gallery.map((img: string, imgIdx: number) => (
                                                <img
                                                    src={img}
                                                    alt={`${project.title} mobile preview ${imgIdx + 1}`}
                                                    loading="lazy"
                                                    decoding="async"
                                                    class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-400 ease-in-out ${imgIdx === 0 ? "opacity-100 z-10" : "opacity-0 z-0"}`}
                                                />
                                            ))}
                                        </div>
                                    </div>

                                    <p class="text-sm md:text-base leading-relaxed text-brand-text/70 max-w-2xl">
                                        {project.description}
                                    </p>

                                    <div class="flex flex-wrap gap-2">
                                        {project.tags.map((tag: string) => (
                                            <span class="px-3 py-1 bg-brand-accent/10 border border-brand-accent/20 rounded-full text-[9px] font-bold tracking-widest text-brand-accent uppercase">
                                                {tag}
                                            </span>
                                        ))}
                                    </div>

                                    {project.link !== "#" && (
                                        <div class="pt-4">
                                            <a 
                                                href={project.link} 
                                                target="_blank"
                                                class="group/btn inline-flex items-center gap-3 text-[11px] font-bold tracking-[0.3em] uppercase text-brand-text border-b border-brand-text/20 pb-1.5 hover:border-brand-accent hover:text-brand-accent transition-colors w-fit"
                                            >
                                                EXPLORE PROJECT
                                                <span class="group-hover/btn:translate-x-1 group-hover/btn:-translate-y-[1px] transition-transform duration-300">
                                                    <IconArrowRight size={14} stroke={2} />
                                                </span>
                                            </a>
                                        </div>
                                    )}
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>

        </div>
    </div>
</section>

<style>
    .project-row.is-active .project-row-panel {
        grid-template-rows: 1fr;
        opacity: 1;
    }
    .project-row.is-active .row-chevron-box {
        border-color: var(--color-brand-accent);
        background-color: rgba(229, 209, 184, 0.1);
    }
    .project-row.is-active .row-chevron-box span {
        color: var(--color-brand-accent);
        transform: rotate(45deg);
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);
    ScrollTrigger.config({ limitCallbacks: true });

    const initProjects = () => {
        const headers = ["#projects-tag", "#projects-title", "#projects-info"];
        
        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: "#projects",
                start: "top 80%",
            }
        });

        tl.from(headers, {
            y: 30,
            opacity: 0,
            stagger: 0.08,
            duration: 0.25,
            ease: "power2.out",
        })
        .from(".project-row", {
            y: 30,
            opacity: 0,
            stagger: 0.06,
            duration: 0.25,
            ease: "expo.out",
        }, "-=0.1");

        gsap.to("#projects-bg-text", {
            scrollTrigger: {
                trigger: "#projects",
                start: "top bottom",
                end: "bottom top",
                scrub: 1.5,
            },
            y: 100,
            ease: "none",
        });

        const rows = document.querySelectorAll<HTMLElement>(".project-row");
        const showcases = document.querySelectorAll<HTMLElement>(".project-showcase");

        const updateActiveShowcase = (activeIndex: number) => {
            showcases.forEach((showcase, sIdx) => {
                if (sIdx === activeIndex) {
                    showcase.classList.add("opacity-100", "scale-100", "z-10");
                    showcase.classList.remove("opacity-0", "scale-95", "z-0", "pointer-events-none");
                } else {
                    showcase.classList.add("opacity-0", "scale-95", "z-0", "pointer-events-none");
                    showcase.classList.remove("opacity-100", "scale-100", "z-10");
                }
            });
        };

        rows.forEach((row) => {
            const trigger = row.querySelector(".row-trigger");
            const pIdx = parseInt(row.dataset.projectIndex || "0");

            if (!trigger) return;

            trigger.addEventListener("click", () => {
                const isActive = row.classList.contains("is-active");
                rows.forEach((r) => r.classList.remove("is-active"));
                
                if (!isActive) {
                    row.classList.add("is-active");
                    updateActiveShowcase(pIdx);
                }
            });

            row.addEventListener("mouseenter", () => {
                if (window.innerWidth >= 1024) {
                    rows.forEach((r) => r.classList.remove("is-active"));
                    row.classList.add("is-active");
                    updateActiveShowcase(pIdx);
                }
            });
        });

        const startGalleryInterval = (galleryElement: HTMLElement) => {
            const images = galleryElement.querySelectorAll("img");
            if (images.length <= 1) return;

            let currentIndex = 0;
            setInterval(() => {
                const nextIndex = (currentIndex + 1) % images.length;
                images.forEach((img) => {
                    img.style.zIndex = "0";
                    img.classList.remove("opacity-100");
                    img.classList.add("opacity-0");
                });
                images[nextIndex].style.zIndex = "10";
                images[nextIndex].classList.add("opacity-100");
                images[nextIndex].classList.remove("opacity-0");
                currentIndex = nextIndex;
            }, 3500);
        };

        showcases.forEach(startGalleryInterval);
        document.querySelectorAll<HTMLElement>(".project-mobile-gallery").forEach(startGalleryInterval);
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initProjects);
    } else {
        initProjects();
    }
</script>
