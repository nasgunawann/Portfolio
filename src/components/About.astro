---
import nas from "@/assets/nasgun_portrait.png";
import { Image } from "astro:assets";
---

<section
    id="about"
    class="relative min-h-screen bg-brand-bg py-12 md:py-24 px-6 md:px-12 overflow-hidden"
>
    <!-- Background Large Typography (Decorative) -->
    <div
        class="absolute inset-0 w-full flex justify-center pointer-events-none select-none z-0"
    >
        <div
            class="h-screen flex items-center justify-center sticky top-0"
            id="about-bg-container"
        >
            <span
                class="text-[25vw] font-bold text-brand-text/5 leading-none tracking-tighter"
                id="about-bg-text"
            >
                STORY
            </span>
        </div>
    </div>

    <div class="max-w-7xl mx-auto relative z-10" id="about-content-wrapper">
        <!-- Section Header -->
        <div
            class="flex flex-col md:flex-row md:items-end justify-between mb-12 md:mb-20 gap-8"
        >
            <div class="overflow-hidden">
                <h2
                    class="text-brand-accent mb-4 tracking-[0.5em] uppercase"
                    id="about-tag"
                >
                    01 / Cloud-Native Full-Stack Developer
                </h2>
                <h3
                    class="text-4xl md:text-8xl font-bold leading-none tracking-widest uppercase"
                    id="about-title"
                >
                    DESIGNING <br /> THE FUTURE
                </h3>
            </div>
            <div class="md:text-right max-w-xs overflow-hidden">
                <p
                    class="text-[11px] leading-relaxed text-brand-text/50 uppercase tracking-widest"
                    id="about-info"
                >
                    Fusing Technical Robustness with Design Excellence to Build
                    Digital Landmarks.
                </p>
            </div>
        </div>

        <!-- Content Grid (Asymmetric Editorial) -->
        <div
            class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-24 items-start"
        >
            <!-- Profile Image (Candid) -->
            <div class="hidden md:block md:col-span-4 order-2 md:order-1">
                <div
                    class="aspect-4/5 bg-brand-text/5 rounded-4xl md:rounded-[3rem] overflow-hidden border border-brand-text/10"
                >
                    <Image
                        src={nas}
                        alt="Nasrullah Gunawan Portfolio Candid"
                        width={600}
                        height={800}
                        loading="lazy"
                        class="w-full h-full object-contain grayscale hover:grayscale-0 transition-all duration-1000 scale-110 group-hover:scale-110"
                    />
                </div>
                <!-- Editorial Caption -->
                <div class="mt-6 flex items-center gap-4">
                    <div class="h-px w-8 bg-brand-text/20"></div>
                    <span
                        class="text-[10px] text-brand-text/70 tracking-[0.2em] uppercase font-bold"
                    >
                        I BRING YOUR APP IDEAS TO LIFE, AND I BUILD THEM TO SCALE.
                    </span>
                </div>
            </div>

            <!-- Narrative -->
            <div
                class="md:col-span-8 flex flex-col justify-center space-y-8 md:space-y-12 order-1 md:order-2"
            >
                <div class="space-y-4 md:space-y-8">
                    <p
                        class="text-xl md:text-3xl leading-relaxed text-brand-text/90 font-medium"
                        id="about-p1"
                    >
                    I am a <span class="text-brand-text font-bold italic"
                        >Cloud-Native Full-Stack Developer</span
                    >
                    specializing in building high-performance, scalable web applications using modern architectures. Based in Medan, North Sumatra, I have extensive experience in deploying robust digital solutions.
                    </p>
                    <div class="h-px w-full bg-brand-text/5"></div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                        <div class="space-y-4">
                            <h4
                                class="text-[15px] font-bold tracking-[0.2em] text-brand-accent uppercase"
                            >
                                Expertise
                            </h4>
                            <p
                                class="text-[14px] leading-relaxed text-brand-text/60"
                            >
                                My core technical expertise spans the <span class="text-brand-text font-semibold">JavaScript/TypeScript (Next.js, React, NestJS)</span> and <span class="text-brand-text font-semibold">PHP (Laravel)</span> ecosystems, complemented by strong cloud computing and DevOps capabilities — including <span class="text-brand-text font-semibold">AWS Certified Cloud Practitioner</span> with deep knowledge of EC2, S3, RDS, and network security.
                            </p>
                        </div>
                        <div class="space-y-4">
                            <h4
                                class="text-[15px] font-bold tracking-[0.2em] text-brand-accent uppercase"
                            >
                                Philosophy
                            </h4>
                            <p
                                class="text-[14px] leading-relaxed text-brand-text/60"
                            >
                                I bridge sophisticated backend infrastructures with <span class="text-brand-text font-semibold">Generative AI/LLM integrations</span> (IBM Granite, Gemini) and seamless user experiences — from serverless applications and automated CI/CD pipelines to containerized deployments using Docker on VPS.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Technical Toolkit (Editorial Style) -->
                <div class="pt-8">
                    <h4
                        class="text-[20px] font-bold tracking-[0.4em] text-brand-text uppercase mb-4"
                    >
                        Technical Arsenal
                    </h4>
                    <div class="flex flex-wrap gap-4">
                        {
                            [
                                "LARAVEL",
                                "NEXT.JS",
                                "NESTJS",
                                "TYPESCRIPT",
                                "DOCKER",
                                "AWS",
                                "SUPABASE",
                                "POSTGRESQL",
                                "CI/CD",
                                "TAILWIND CSS",
                                "GEN AI/LLM",
                            ].map((tool) => (
                                <div class="px-5 py-2 bg-brand-accent/10 border border-brand-accent/20 rounded-full text-[11px] font-black tracking-[0.2em] text-brand-accent hover:bg-brand-accent hover:text-brand-bg transition-all duration-300 uppercase cursor-default">
                                    {tool}
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap as localGsap } from "gsap";
    import { ScrollTrigger as localScrollTrigger } from "gsap/ScrollTrigger";

    const gsap = (window as any).gsap || localGsap;
    const ScrollTrigger = (window as any).ScrollTrigger || localScrollTrigger;

    gsap.registerPlugin(ScrollTrigger);
    (window as any).gsap = gsap;
    (window as any).ScrollTrigger = ScrollTrigger;

    const initAbout = () => {
        gsap.from("#about-content-wrapper", {
            scrollTrigger: {
                trigger: "#about",
                start: "top 85%",
            },
            y: 40,
            opacity: 0,
            duration: 0.5,
            ease: "power2.out",
        });

        gsap.to("#about-bg-text", {
            scrollTrigger: {
                trigger: "#about",
                start: "top bottom",
                end: "bottom top",
                scrub: 1.5,
            },
            y: 100,
            ease: "none",
        });
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initAbout);
    } else {
        initAbout();
    }
</script>
